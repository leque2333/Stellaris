# ==========================================
# 敏感凭据与本地工作区配置 (Secrets & Tokens)
# ==========================================
.env
.env.*
*.key
*.pem
*.token
*.secret

# ==========================================
# 本地持久化数据与私有配置 (Data & Backups)
# ==========================================
data/
backups/
*core_settings*.md
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak*

# ==========================================
# 私人敏感档案与日志 (Private Archives & Logs)
# ==========================================
项目档案.md
PROJECT_ARCHIVE.md
*.log
stderr.log
stdout.log

# ==========================================
# Python 运行缓存与开发环境 (Python & IDEs)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.vscode/
.idea/
.DS_Store
Thumbs.db
