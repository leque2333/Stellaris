# ==========================================
# 敏感凭据与本地工作区配置 (Secrets & Tokens)
# ==========================================
.env
.env.*
*.key
*.pem
*.token
*.secret

# ==========================================
# 本地持久化数据与私有配置 (Data & Backups)
# ==========================================
data/
backups/
*core_settings*.md
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.bak*

# ==========================================
# 私人敏感档案与日志 (Private Archives & Logs)
# ==========================================
*.log
stderr.log
stdout.log

# ==========================================
# Python 运行缓存与开发环境 (Python & IDEs)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==========================================
# 归档与本地工具配置（不进仓库）
# ==========================================
archive/
.agents/
requirements-agent.txt

# ==========================================
# 本地临时文件（测试输出 / 首启口令，绝不入库）
# ==========================================
.tmp/
.tmp_*
data/auth_initial_password.txt

# ==========================================
# 审计 / 复核报告：只留本地，不随仓库发布
# ==========================================
docs/ACCEPTANCE_AUDIT_*.md
docs/ACCEPTANCE_RECHECK_*.md
docs/ACCEPTANCE_RETEST_*.md